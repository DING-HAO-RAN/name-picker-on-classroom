{
  "name": "name-picker",
  "version": "1.1.1",
  "private": true,
  "author": "NamePicker",
  "description": "离线课堂随机点名桌面应用：名单、权重与抽取记录只存本机，无网络、无遥测。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DING-HAO-RAN/classroom-name-picker.git"
  },
  "homepage": "https://github.com/DING-HAO-RAN/classroom-name-picker",
  "bugs": "https://github.com/DING-HAO-RAN/classroom-name-picker/issues",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "vitest",
    "test:e2e": "npm run build && playwright test",
    "package:win": "npm run build && electron-builder --config electron-builder.config.cjs --win nsis portable --x64 --publish never"
  },
  "dependencies": {
    "papaparse": "5.5.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "electron": "36.3.2",
    "@playwright/test": "1.51.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@types/papaparse": "5.3.15",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "@vitejs/plugin-react": "4.4.1",
    "electron-builder": "26.0.12",
    "electron-vite": "3.1.0",
    "jsdom": "26.0.0",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vitest": "3.1.3"
  },
  "build": {
    "appId": "com.namepicker.desktop",
    "productName": "NamePicker",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*"
    ],
    "publish": null,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NamePicker",
      "artifactName": "${productName} Setup-${version}.${ext}",
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "${productName}-${version}.${ext}"
    }
  }
}
